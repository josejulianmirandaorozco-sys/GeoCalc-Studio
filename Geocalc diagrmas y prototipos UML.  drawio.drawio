        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\npackage \&quot;modelo\&quot; {\n    abstract class Poligono {\n        + {abstract} area(): double\n        + {abstract} perimetro(): double\n    }\n\n    class Cuadrado {\n        - lado: double\n        + Cuadrado(lado: double)\n        + area(): double\n        + perimetro(): double\n        + getLado(): double\n        + setLado(lado: double): void\n    }\n\n    class Rectangulo {\n        - base: double\n        - altura: double\n        + Rectangulo(base: double, altura: double)\n        + area(): double\n        + perimetro(): double\n        + getBase(): double\n        + setBase(base: double): void\n        + getAltura(): double\n        + setAltura(altura: double): void\n    }\n\n    class Triangulo {\n        - base: double\n        - altura: double\n        - lado1: double\n        - lado2: double\n        + Triangulo(base: double, altura: double, lado1: double, lado2: double)\n        + area(): double\n        + perimetro(): double\n        + getBase(): double\n        + setBase(base: double): void\n        + getAltura(): double\n        + setAltura(altura: double): void\n        + getLado1(): double\n        + setLado1(lado1: double): void\n        + getLado2(): double\n        + setLado2(lado2: double): void\n    }\n\n    class Trapecio {\n        - baseMayor: double\n        - baseMenor: double\n        - altura: double\n        - lado1: double\n        - lado2: double\n        + Trapecio(baseMayor: double, baseMenor: double, altura: double, lado1: double, lado2: double)\n        + area(): double\n        + perimetro(): double\n        + getBaseMayor(): double\n        + setBaseMayor(baseMayor: double): void\n        + getBaseMenor(): double\n        + setBaseMenor(baseMenor: double): void\n        + getAltura(): double\n        + setAltura(altura: double): void\n        + getLado1(): double\n        + setLado1(lado1: double): void\n        + getLado2(): double\n        + setLado2(lado2: double): void\n    }\n\n    Poligono &lt;|-- Cuadrado\n    Poligono &lt;|-- Rectangulo\n    Poligono &lt;|-- Triangulo\n    Poligono &lt;|-- Trapecio\n}\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="A_nEPR1unm-GgIEw06N6-1">
